{
  "$schema": "aceve-onboard-flow-registry/v0-draft",
  "id": "next-project",
  "country": "SE",
  "flowVersion": "0.1.0",
  "status": "DRAFT — flow structure from CUSTOMER-FLOW.md (validated prototypes); category list pending PS confirmation (STATUS.md Q33)",
  "productName": "Next Project",
  "entryNotice": {
    "note": "R3 (Carl 2026-08-31): entry is triggered by the closed-won opportunity — the signed agreement is a fact when the customer lands here, so no confirmation checkbox. The lead-generating self-signup scenario is a possible later scope, not today's flow.",
    "label": {
      "sv": "Ni har ett signerat avtal med Aceve för {productName} — därför är ni här.",
      "en": "You have a signed agreement with Aceve for {productName} — that is why you are here."
    }
  },
  "phases": [
    {
      "id": "preparation",
      "name": {
        "sv": "Förberedelse",
        "en": "Preparation"
      }
    },
    {
      "id": "kartlaggning",
      "name": {
        "sv": "Kartläggning",
        "en": "Mapping"
      }
    },
    {
      "id": "migration",
      "name": {
        "sv": "Datamigration",
        "en": "Data migration"
      }
    },
    {
      "id": "finish",
      "name": {
        "sv": "Slutför",
        "en": "Finish"
      }
    }
  ],
  "categories": {
    "note": "Order honours the two documented constraints: kontoplan first, timpriser before anvandarregister ('Yrkesroll (från timpriser)'). List = Stitch's 6 import categories; authoritative list pending Q33 — change here, never in code.",
    "sequentialUnlock": true,
    "moduleIds": [
      "kontoplan",
      "timpriser",
      "anvandarregister",
      "prislista",
      "kunder",
      "projekt"
    ]
  },
  "steps": [
    {
      "id": "valkommen",
      "phase": "preparation",
      "kind": "info",
      "gated": false,
      "name": {
        "sv": "Välkommen",
        "en": "Welcome"
      },
      "shortDescription": {
        "sv": "Introduktion",
        "en": "Introduction"
      },
      "subtitle": {
        "sv": "Så fungerar er onboarding — två faser, i er egen takt.",
        "en": "How your onboarding works — two phases, at your own pace."
      },
      "cards": [
        {
          "title": {
            "sv": "Fas 1 – Förberedelse",
            "en": "Phase 1 – Preparation"
          },
          "body": {
            "sv": "Företagsuppgifter, er verksamhet, superanvändare, utbildningar och ansvarsfördelning. Flera personer kan arbeta parallellt och ser varandras framsteg.",
            "en": "Company details, your business, superusers, trainings and the responsibility split. Several people can work in parallel and see each other's progress."
          }
        },
        {
          "title": {
            "sv": "Fas 2 – Datamigration",
            "en": "Phase 2 – Data migration"
          },
          "body": {
            "sv": "Er data förbereds kategori för kategori. Ni väljer metod per kategori, ser i förväg exakt vilka fält som behövs — och inget skickas vidare utan er bekräftelse.",
            "en": "Your data is prepared category by category. You choose a method per category, see up front exactly which fields are needed — and nothing is passed on without your confirmation."
          }
        }
      ]
    },
    {
      "id": "foretagsuppgifter",
      "phase": "preparation",
      "kind": "form",
      "gated": true,
      "name": {
        "sv": "Företagsuppgifter",
        "en": "Company details"
      },
      "shortDescription": {
        "sv": "Grund, land & språk",
        "en": "Basics, country & language"
      },
      "subtitle": {
        "sv": "Land och språk styr vilken produkt och vilka utbildningar ni lotsas till.",
        "en": "Country and language decide which product and which trainings you are guided to."
      },
      "sections": [
        {
          "title": {
            "sv": "Grunduppgifter",
            "en": "Basic details"
          },
          "fields": [
            {
              "id": "legalName",
              "type": "text",
              "required": true,
              "seededFrom": "salesforce",
              "label": {
                "sv": "Juridiskt företagsnamn",
                "en": "Legal company name"
              }
            },
            {
              "id": "prefix",
              "type": "text",
              "required": true,
              "label": {
                "sv": "Företagsprefix / akronym",
                "en": "Company prefix / acronym"
              }
            },
            {
              "id": "orgNumber",
              "type": "text",
              "required": true,
              "seededFrom": "salesforce",
              "label": {
                "sv": "Organisationsnummer",
                "en": "Organisation number"
              },
              "pattern": "^[0-9]{6,8}-?[0-9]{4}$",
              "patternHint": {
                "sv": "Format: NNNNNN-NNNN",
                "en": "Format: NNNNNN-NNNN"
              }
            },
            {
              "id": "invoiceAddress",
              "type": "text",
              "required": false,
              "label": {
                "sv": "Fakturaadress",
                "en": "Invoice address"
              }
            }
          ]
        },
        {
          "title": {
            "sv": "Land & språk",
            "en": "Country & language"
          },
          "fields": [
            {
              "id": "country",
              "type": "select",
              "required": true,
              "seededFrom": "salesforce",
              "label": {
                "sv": "Land",
                "en": "Country"
              },
              "options": [
                {
                  "value": "SE",
                  "label": {
                    "sv": "Sverige",
                    "en": "Sweden"
                  }
                },
                {
                  "value": "NO",
                  "label": {
                    "sv": "Norge",
                    "en": "Norway"
                  }
                },
                {
                  "value": "DK",
                  "label": {
                    "sv": "Danmark",
                    "en": "Denmark"
                  }
                },
                {
                  "value": "FI",
                  "label": {
                    "sv": "Finland",
                    "en": "Finland"
                  }
                },
                {
                  "value": "NL",
                  "label": {
                    "sv": "Nederländerna",
                    "en": "Netherlands"
                  }
                }
              ]
            },
            {
              "id": "language",
              "type": "select",
              "required": true,
              "label": {
                "sv": "Språk",
                "en": "Language"
              },
              "options": [
                {
                  "value": "sv",
                  "label": {
                    "sv": "Svenska",
                    "en": "Swedish"
                  }
                },
                {
                  "value": "en",
                  "label": {
                    "sv": "Engelska",
                    "en": "English"
                  }
                },
                {
                  "value": "no",
                  "label": {
                    "sv": "Norska",
                    "en": "Norwegian"
                  }
                },
                {
                  "value": "da",
                  "label": {
                    "sv": "Danska",
                    "en": "Danish"
                  }
                },
                {
                  "value": "fi",
                  "label": {
                    "sv": "Finska",
                    "en": "Finnish"
                  }
                },
                {
                  "value": "nl",
                  "label": {
                    "sv": "Nederländska",
                    "en": "Dutch"
                  }
                },
                {
                  "value": "de",
                  "label": {
                    "sv": "Tyska",
                    "en": "German"
                  }
                },
                {
                  "value": "fr",
                  "label": {
                    "sv": "Franska",
                    "en": "French"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "verksamhet",
      "phase": "preparation",
      "kind": "form",
      "gated": true,
      "name": {
        "sv": "Er verksamhet & bakgrund",
        "en": "Your business & background"
      },
      "shortDescription": {
        "sv": "Profil, geografi, källsystem",
        "en": "Profile, geography, source system"
      },
      "subtitle": {
        "sv": "Hjälper oss anpassa uppsättningen efter hur ni arbetar.",
        "en": "Helps us tailor the setup to how you work."
      },
      "sections": [
        {
          "title": {
            "sv": "Verksamhet",
            "en": "Business"
          },
          "fields": [
            {
              "id": "workTypes",
              "type": "chips",
              "required": true,
              "label": {
                "sv": "Typ av arbeten",
                "en": "Types of work"
              },
              "options": [
                {
                  "value": "entreprenad",
                  "label": {
                    "sv": "Entreprenad",
                    "en": "Contracting"
                  }
                },
                {
                  "value": "mark",
                  "label": {
                    "sv": "Mark & anläggning",
                    "en": "Groundwork & civil engineering"
                  }
                },
                {
                  "value": "service",
                  "label": {
                    "sv": "Service",
                    "en": "Service"
                  }
                },
                {
                  "value": "installation",
                  "label": {
                    "sv": "Installation",
                    "en": "Installation"
                  }
                },
                {
                  "value": "bygg",
                  "label": {
                    "sv": "Bygg",
                    "en": "Construction"
                  }
                },
                {
                  "value": "renovering",
                  "label": {
                    "sv": "Renovering",
                    "en": "Renovation"
                  }
                },
                {
                  "value": "underhall",
                  "label": {
                    "sv": "Underhåll",
                    "en": "Maintenance"
                  }
                }
              ]
            },
            {
              "id": "officeStaff",
