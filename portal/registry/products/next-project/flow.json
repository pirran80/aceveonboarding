            {
              "id": "regions",
              "type": "text",
              "required": false,
              "label": {
                "sv": "Region(er)",
                "en": "Region(s)"
              }
            },
            {
              "id": "offices",
              "type": "text",
              "required": false,
              "label": {
                "sv": "Kontor",
                "en": "Offices"
              }
            },
            {
              "id": "reach",
              "type": "select",
              "required": true,
              "label": {
                "sv": "Arbetar ni lokalt, nationellt eller internationellt?",
                "en": "Do you work locally, nationally or internationally?"
              },
              "options": [
                {
                  "value": "local",
                  "label": {
                    "sv": "Lokalt",
                    "en": "Locally"
                  }
                },
                {
                  "value": "national",
                  "label": {
                    "sv": "Nationellt",
                    "en": "Nationally"
                  }
                },
                {
                  "value": "international",
                  "label": {
                    "sv": "Internationellt",
                    "en": "Internationally"
                  }
                }
              ]
            }
          ]
        },
        {
          "title": {
            "sv": "Bakgrund",
            "en": "Background"
          },
          "fields": [
            {
              "id": "fromBso",
              "type": "toggle",
              "required": false,
              "label": {
                "sv": "Vi kommer från Byggsamordnaren (BSO)",
                "en": "We are coming from Byggsamordnaren (BSO)"
              },
              "conditionalFields": {
                "note": "The source system decides which extra fields and which export route apply. The BSO export is not self-service — hence an IT contact, not the project contact.",
                "title": {
                  "sv": "IT-kontaktperson (för dataexport från BSO)",
                  "en": "IT contact (for data export from BSO)"
                },
                "fields": [
                  {
                    "id": "itContactName",
                    "type": "text",
                    "required": true,
                    "label": {
                      "sv": "Namn",
                      "en": "Name"
                    }
                  },
                  {
                    "id": "itContactEmail",
                    "type": "email",
                    "required": true,
                    "label": {
                      "sv": "E-post",
                      "en": "Email"
                    }
                  },
                  {
                    "id": "itContactPhone",
                    "type": "text",
                    "required": false,
                    "label": {
                      "sv": "Telefon",
                      "en": "Phone"
                    }
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "id": "superanvandare",
      "phase": "preparation",
      "kind": "people",
      "gated": true,
      "name": {
        "sv": "Superanvändare",
        "en": "Superusers"
      },
      "shortDescription": {
        "sv": "Minst 2 personer",
        "en": "At least 2 people"
      },
      "subtitle": {
        "sv": "E-postadressen används för utbildningsinbjudningar. Ni kan delegera ansvar för datakategorier till dessa personer.",
        "en": "The email address is used for training invitations. You can delegate responsibility for data categories to these people."
      },
      "minValid": 2
    },
    {
      "id": "webbinarier",
      "phase": "preparation",
      "kind": "webinars",
      "gated": true,
      "dependsOn": [
        "superanvandare"
      ],
      "name": {
        "sv": "Utbildningar",
        "en": "Trainings"
      },
      "shortDescription": {
        "sv": "3 utbildningar",
        "en": "3 trainings"
      },
      "subtitle": {
        "sv": "Alla superanvändare bokar in sig på tre korta utbildningar.",
        "en": "Every superuser signs up for three short trainings."
      },
      "webinars": [
        {
          "id": "ny-i-next",
          "name": {
            "sv": "Ny i Next",
            "en": "New to Next"
          }
        },
        {
          "id": "ekonomiflode",
          "name": {
            "sv": "Grundläggande ekonomiflöde",
            "en": "Basic finance flow"
          }
        },
        {
          "id": "budget-inkop",
          "name": {
            "sv": "Budget, inköp och prognos",
            "en": "Budget, purchasing and forecasting"
          }
        }
      ]
    },
    {
      "id": "ansvarsfordelning",
      "phase": "preparation",
      "kind": "consents",
      "gated": true,
      "name": {
        "sv": "Ansvarsfördelning",
        "en": "Responsibility split"
      },
      "shortDescription": {
        "sv": "Läs och bekräfta",
        "en": "Read and confirm"
      },
      "subtitle": {
        "sv": "Aceve behandlar era uppgifter för att leverera migrering och uppsättning, i enlighet med ingånget DPA.",
        "en": "Aceve processes your data to deliver the migration and setup, in accordance with the signed DPA."
      },
      "document": {
        "label": {
          "sv": "Ansvarsfördelning (PDF)",
          "en": "Responsibility split (PDF)"
        },
        "href": "#"
      },
      "consents": [
        {
          "id": "readUnderstood",
          "group": null,
          "label": {
            "sv": "Vi har läst och förstår ansvarsfördelningen",
            "en": "We have read and understand the responsibility split"
          }
        },
        {
          "id": "aiTools",
          "group": "dataProcessing",
          "label": {
            "sv": "Vi godkänner att AI-baserade verktyg (inkl. Ingestro) används som en del av behandlingen",
            "en": "We approve that AI-based tools (incl. Ingestro) are used as part of the processing"
          }
        },
        {
          "id": "informStaff",
          "group": "dataProcessing",
          "label": {
            "sv": "Vi ansvarar för att informera våra medarbetare om denna behandling",
            "en": "We are responsible for informing our staff about this processing"
          }
        }
      ],
      "note": "Wording is the starting draft for Legal (STATUS.md Q8) — pending final legal copy."
    },
    {
      "id": "kartlaggning-ekonomi",
      "phase": "kartlaggning",
      "kind": "form",
      "gated": true,
      "blocking": false,
      "note": "DRAFT question set — to be replaced by the converted Kundmall batteries (Fortnox / Visma Admin / E-invoice; STATUS.md Next Action 22, content from Carl). The mechanism is the deliverable: non-blocking phase (R7: gating within the flow, never between Kartläggning and Datamigrering) + categoryEffects (answers make categories integration-sourced, R10).",
      "name": {
        "sv": "Ekonomi & integrationer",
        "en": "Finance & integrations"
      },
      "shortDescription": {
        "sv": "Styr era datasteg",
        "en": "Steers your data steps"
      },
      "subtitle": {
        "sv": "Era svar styr vilka datakategorier ni laddar upp själva — och vilka som hämtas via integration. Ni kan arbeta med datastegen parallellt.",
        "en": "Your answers decide which data categories you upload yourselves — and which are fetched via integration. You can work on the data steps in parallel."
      },
      "sections": [
        {
          "title": {
            "sv": "Ekonomisystem",
            "en": "Finance system"
          },
          "fields": [
            {
              "id": "financeSystem",
              "type": "select",
              "required": true,
              "label": {
                "sv": "Vilket ekonomisystem använder ni?",
                "en": "Which finance system do you use?"
              },
              "options": [
                {
                  "value": "fortnox",
                  "label": {
                    "sv": "Fortnox",
                    "en": "Fortnox"
                  }
                },
                {
                  "value": "visma-admin",
                  "label": {
                    "sv": "Visma Administration",
                    "en": "Visma Administration"
                  }
                },
                {
                  "value": "other",
                  "label": {
                    "sv": "Annat",
                    "en": "Other"
                  }
                },
                {
                  "value": "none",
                  "label": {
                    "sv": "Inget",
                    "en": "None"
                  }
                }
              ]
            },
            {
              "id": "kontoplanSource",
              "type": "select",
              "required": true,
              "label": {
                "sv": "Hur ska kontoplanen komma in?",
                "en": "How should the chart of accounts come in?"
              },
              "options": [
                {
                  "value": "integration",
                  "label": {
                    "sv": "Hämtas via ekonomisystem-integrationen",
                    "en": "Fetched via the finance-system integration"
                  }
                },
                {
                  "value": "upload",
                  "label": {
                    "sv": "Vi laddar upp den själva",
                    "en": "We upload it ourselves"
                  }
                }
              ]
            },
            {
              "id": "kundregisterSource",
              "type": "select",
              "required": true,
              "label": {
                "sv": "Hur ska kundregistret komma in?",
                "en": "How should the customer register come in?"
              },
              "options": [
                {
                  "value": "integration",
                  "label": {
                    "sv": "Speglas via ekonomisystem-integrationen — undviker dubbletter",
                    "en": "Mirrored via the finance-system integration — avoids duplicates"
                  }
                },
                {
                  "value": "upload",
                  "label": {
                    "sv": "Vi laddar upp det själva",
                    "en": "We upload it ourselves"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "migrationsplan",
      "phase": "migration",
      "kind": "migration-plan",
      "gated": true,
      "name": {
        "sv": "Migrationsplan",
        "en": "Migration plan"
      },
      "shortDescription": {
        "sv": "GI-mall & metodval",
        "en": "GI template & method choice"
      },
      "subtitle": {
        "sv": "Välj metod per datakategori — i er takt. Att hoppa över en kategori är ett fullvärdigt val.",
        "en": "Choose a method per data category — at your pace. Skipping a category is a first-class choice."
      },
      "acknowledgements": [
        {
          "id": "onlyOngoing",
          "label": {
            "sv": "Vi förstår att endast projekt med status Pågående migreras",
            "en": "We understand that only projects with status Ongoing are migrated"
          }
        },
        {
          "id": "restExcluded",
          "label": {
            "sv": "Vi förstår att övriga projekt inte ingår i migreringen",
            "en": "We understand that other projects are not included in the migration"
          }
        }
      ]
    },
    {
      "id": "skicka-boka",
      "phase": "finish",
      "kind": "finish",
      "gated": false,
      "name": {
        "sv": "Skicka & boka uppstart",
        "en": "Submit & book go-live"
      },
      "shortDescription": {
        "sv": "Lås upp när allt är klart",
        "en": "Unlocks when everything is done"
      },
      "subtitle": {
        "sv": "När alla steg är klara skickas ert underlag till Aceve och ni bokar uppstart.",
        "en": "When every step is done, your material is sent to Aceve and you book the go-live."
      }
    }
  ],
  "categoryEffects": [
    {
      "when": {
        "stepId": "kartlaggning-ekonomi",
        "fieldId": "kontoplanSource",
        "equals": "integration"
      },
      "then": {
        "moduleId": "kontoplan",
        "source": "integration"
      }
    },
    {
      "when": {
        "stepId": "kartlaggning-ekonomi",
        "fieldId": "kundregisterSource",
        "equals": "integration"
      },
      "then": {
        "moduleId": "kunder",
        "source": "integration"
      }
    }
  ]
}
